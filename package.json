{
  "name": "@deepwhale-cn/dsh-cn-agreement-check",
  "version": "0.1.0",
  "description": "检查用户协议/隐私政策文本的条款级红线：单方最终解释权、不合理管辖约定、单方解除权、自动续费未提示、个人信息捆绑授权——每条带法规出处",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skill",
    "用户协议",
    "隐私政策",
    "格式条款",
    "红线"
  ],
  "files": [
    "lib",
    "skill",
    "bin",
    "rules",
    "docs",
    "cordis.patch.yml",
    "tests/fixtures",
    "README.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-cn-agreement-check": "bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.10.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-cn-agreement-check.git"
  },
  "homepage": "https://www.deepwhale.org.cn/skills.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-cn-agreement-check/issues"
  }
}
